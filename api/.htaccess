# API .htaccess
Options -Indexes

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Clean URLs
RewriteRule ^waiting-times$    waiting-times.php [L,QSA]
RewriteRule ^routes$           routes.php        [L,QSA]
RewriteRule ^reports$          reports.php        [L,QSA]
RewriteRule ^stats$            stats.php          [L,QSA]
RewriteRule ^search$           search.php         [L,QSA]
RewriteRule ^places$           places.php         [L,QSA]
RewriteRule ^geocoding$        geocoding.php      [L,QSA]
RewriteRule ^routing$          routing.php        [L,QSA]
RewriteRule ^map-config$       map-config.php     [L,QSA]
