# Root .htaccess — Protect backend files from direct browser access
Options -Indexes

<FilesMatch "\.(json|md|env|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/   - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^data/     - [F,L]
</IfModule>
